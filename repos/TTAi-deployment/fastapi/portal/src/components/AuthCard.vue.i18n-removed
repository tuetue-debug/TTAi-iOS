<script setup>
import { reactive, ref } from 'vue'
import { useRouter } from 'vue-router'
import { login, signup } from '../lib/auth'

const props = defineProps({
  mode: { type: String, default: 'login' },
  compact: { type: Boolean, default: false },
})

const router = useRouter()
const loading = ref(false)
const error = ref('')
const showModal = ref(false)

const form = reactive({ name: '', email: '', password: '', agree: false })

function googleLogin() { window.location.href = '/auth/google/start' }
function githubLogin()  { window.location.href = '/auth/github/start' }

function onContinue() { showModal.value = true }

async function onSubmit() {
  error.value = ''
  loading.value = true
  try {
    if (props.mode === 'signup') {
      if (!form.agree) throw new Error('Please accept the terms to continue')
      await signup({ name: form.name, email: form.email, password: form.password })
    } else {
      await login({ email: form.email, password: form.password })
    }
    showModal.value = false
    await router.push('/dashboard')
  } catch (err) {
    error.value = err?.message || 'Authentication failed'
  } finally {
    loading.value = false
  }
}
</script>

<template>
  <!-- ── Compact landing panel ─────────────────────────────── -->
  <div v-if="compact" class="auth-card auth-card-compact">
    <p class="auth-welcome">{{ TEXTHERE }}</p>
    <h2 style="margin-bottom: 20px; font-size: 20px;">{{ TEXTHERE }}</h2>

    <form class="auth-form" @submit.prevent="onContinue">
      <label>
        <span>{{ TEXTHERE }}</span>
        <input v-model="form.email" type="email" :placeholder="TEXTHERE" required />
      </label>
      <button class="primary-btn full" type="submit">Continue →</button>
    </form>

    <div class="divider"><span>or</span></div>

    <div class="social-buttons">
      <button class="social-btn" type="button" @click="googleLogin">
        <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.91 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </button>
      <button class="social-btn" type="button" @click="githubLogin">
        <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        Continue with GitHub
      </button>
    </div>

    <p class="auth-footer">
      New to Tue Tue AI? <RouterLink to="/signup">{{ TEXTHERE }}</RouterLink>
    </p>
  </div>

  <!-- ── Full mode (login / signup pages) ──────────────────── -->
  <div v-else class="auth-card">
    <div class="auth-header">
      <div>
        <div class="auth-kicker">{{ mode === 'signup' ? 'Join Tue Tue Platform' : 'Welcome back' }}</div>
        <h2>{{ mode === 'signup' ? 'Create your account' : 'Sign in to Tue Tue Platform' }}</h2>
      </div>
      <span class="status-pill">{{ TEXTHERE }}</span>
    </div>

    <div class="social-buttons">
      <button class="social-btn" type="button" @click="googleLogin">
        <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.91 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        Continue with Google
      </button>
      <button class="social-btn" type="button" @click="githubLogin">
        <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
        Continue with GitHub
      </button>
    </div>

    <div class="divider"><span>{{ TEXTHERE }}</span></div>

    <form class="auth-form" @submit.prevent="onSubmit">
      <label v-if="mode === 'signup'">
        <span>{{ TEXTHERE }}</span>
        <input v-model="form.name" type="text" :placeholder="TEXTHERE" />
      </label>
      <label>
        <span>{{ TEXTHERE }}</span>
        <input v-model="form.email" type="email" :placeholder="TEXTHERE" />
      </label>
      <label>
        <span>{{ TEXTHERE }}</span>
        <input v-model="form.password" type="password" :placeholder="TEXTHERE" />
      </label>
      <div class="form-row">
        <label class="checkbox-row">
          <input v-model="form.agree" type="checkbox" />
          <span>{{ mode === 'signup' ? 'I agree to the terms' : 'Remember me' }}</span>
        </label>
        <a v-if="mode === 'signup'" href="#privacy" style="opacity:.5; pointer-events:none">{{ TEXTHERE }}</a>
      </div>
      <button class="primary-btn full" :disabled="loading">
        {{ loading ? 'Please wait…' : (mode === 'signup' ? 'Create account' : 'Sign in') }}
      </button>
      <p v-if="error" class="form-error">{{ error }}</p>
    </form>

    <p class="auth-footer" v-if="mode === 'login'">
      New to Tue Tue AI? <RouterLink to="/signup">{{ TEXTHERE }}</RouterLink>
    </p>
    <p class="auth-footer" v-else>
      Already have an account? <RouterLink to="/login">{{ TEXTHERE }}</RouterLink>
    </p>
  </div>

  <!-- ── Login modal (triggered from compact Continue btn) ──── -->
  <Teleport to="body">
    <div v-if="showModal" class="auth-modal-overlay" @click.self="showModal = false">
      <div class="auth-modal-card">
        <button class="auth-modal-close" type="button" @click="showModal = false">✕</button>

        <p class="auth-welcome">{{ TEXTHERE }}</p>
        <h2 style="margin-bottom: 22px; font-size: 22px;">{{ TEXTHERE }}</h2>

        <form class="auth-form" @submit.prevent="onSubmit">
          <label>
            <span>{{ TEXTHERE }}</span>
            <input v-model="form.email" type="email" :placeholder="TEXTHERE" required />
          </label>
          <label>
            <span>{{ TEXTHERE }}</span>
            <input v-model="form.password" type="password" :placeholder="TEXTHERE" required />
          </label>
          <button class="primary-btn full" :disabled="loading">
            {{ loading ? 'Please wait…' : 'Sign in' }}
          </button>
          <p v-if="error" class="form-error">{{ error }}</p>
        </form>

        <div class="divider"><span>or</span></div>

        <div class="social-buttons">
          <button class="social-btn" type="button" @click="googleLogin">
            <svg width="18" height="18" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
              <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
              <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
              <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.91 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Continue with Google
          </button>
          <button class="social-btn" type="button" @click="githubLogin">
            <svg width="18" height="18" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="currentColor">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.6.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
            Continue with GitHub
          </button>
        </div>

        <p class="auth-footer">
          New to Tue Tue AI? <RouterLink to="/signup" @click="showModal = false">{{ TEXTHERE }}</RouterLink>
        </p>
      </div>
    </div>
  </Teleport>
</template>


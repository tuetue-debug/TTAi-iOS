    "timestamp": "iso-datetime",
    "source_context": "string",
    "query_text": "string",
    "query_class": "string",
    "authoritative_sources": ["string"],
    "freshness_requirement": "low|medium|high",
    "rag_v1": {
      "retrieval_summary": "string",
      "answer": "string",
      "confidence_impression": "string",
      "weaknesses": ["string"]
    },
    "rag_v2": {
      "retrieval_summary": "string",
      "verification": "string",
      "evidence_bundle_summary": "string",
      "scoring_summary": "string",
      "decision": "accept|review|fallback",
      "answer": "string",
      "weaknesses": ["string"]
    },
    "comparison": {

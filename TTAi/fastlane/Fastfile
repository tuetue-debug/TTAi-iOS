# Fastfile for TTAi iOS App
# Automated deployment and release management

default_platform(:ios)

platform :ios do
  # CI/CD Lanes
  
  desc "Run all tests"
  lane :test do
    scan(
      scheme: "TTAi",
      device: "iPhone 15",
      clean: true,
      output_directory: "./fastlane/test_output",
      output_types: "html,junit",
      output_files: "report.html,report.junit",
      fail_build: true
    )
  end
  
  desc "Run SwiftLint"
  lane :lint do
    swiftlint(
      mode: :lint,
      strict: true,
      ignore_exit_status: false,
      output_file: "swiftlint.result.json",
      reporter: "json"
    )
  end
  
  desc "Build the app"
  lane :build do
    gym(
      scheme: "TTAi",
      configuration: "Release",
      clean: true,
      output_directory: "./fastlane/builds",
      output_name: "TTAi.ipa",
      export_method: "app-store",
      export_options: {
        compileBitcode: false,
        uploadBitcode: false,
        uploadSymbols: true,
        thinning: "<none>"
      }
    )
  end
  
  desc "Deploy to TestFlight"
  lane :beta do
    # Increment build number
    increment_build_number(
      build_number: latest_testflight_build_number + 1
    )
    
    # Build the app
    build
    
    # Upload to TestFlight
    pilot(
      ipa: "./fastlane/builds/TTAi.ipa",
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
      demo_account_required: false,
      beta_app_review_info: {
        contact_email: "contact@yourcompany.com",
        contact_first_name: "John",
        contact_last_name: "Doe",
        contact_phone: "+1234567890",
        demo_account_name: "test@example.com",
        demo_account_password: "password123",
        notes: "TestFlight demo account for review"
      },
      localized_app_info: {
        "default": {
          feedback_email: "feedback@yourcompany.com",
          marketing_url: "https://yourcompany.com",
          privacy_policy_url: "https://yourcompany.com/privacy",
          description: "TTAi - Your AI Assistant"
        }
      }
    )
    
    # Send notification
    slack(
      message: "✅ TTAi v#{get_version_number} (#{get_build_number}) deployed to TestFlight",
      success: true,
      payload: {
        "Build Number" => get_build_number,
        "Version" => get_version_number,
        "Environment" => "TestFlight"
      },
      default_payloads: [:git_branch, :git_author]
    )
  end
  
  desc "Deploy to App Store"
  lane :release do
    # Ensure we're on main branch
    ensure_git_branch(branch: 'main')
    
    # Run tests
    test
    
    # Run lint
    lint
    
    # Increment version number if needed
    prompt = UI.input("Do you want to increment version number? (y/n): ")
    if prompt.downcase == 'y'
      increment_version_number(
        bump_type: "patch" # or "minor", "major"
      )
    end
    
    # Increment build number
    increment_build_number(
      build_number: latest_testflight_build_number + 1
    )
    
    # Build the app
    build
    
    # Upload to App Store Connect
    deliver(
      skip_binary_upload: false,
      skip_screenshots: true,
      skip_metadata: true,
      force: true,
      submit_for_review: false,
      automatic_release: false
    )
    
    # Send notification
    slack(
      message: "🚀 TTAi v#{get_version_number} (#{get_build_number}) submitted to App Store",
      success: true,
      payload: {
        "Build Number" => get_build_number,
        "Version" => get_version_number,
        "Environment" => "App Store"
      },
      default_payloads: [:git_branch, :git_author]
    )
  end
  
  desc "Submit for App Store review"
  lane :submit_review do
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
    
    slack(
      message: "📱 TTAi v#{get_version_number} submitted for App Store review",
      success: true
    )
  end
  
  # Utility Lanes
  
  desc "Generate code coverage report"
  lane :coverage do
    scan(
      scheme: "TTAi",
      device: "iPhone 15",
      clean: true,
      code_coverage: true,
      output_directory: "./fastlane/coverage",
      output_types: "html",
      output_files: "coverage.html"
    )
  end
  
  desc "Check dependencies for security vulnerabilities"
  lane :security_check do
    # Check CocoaPods dependencies
    if File.exist?("Podfile")
      sh "bundle exec pod outdated"
      sh "bundle exec pod audit"
    end
    
    # Check Swift Package Manager dependencies
    if File.exist?("Package.swift")
      sh "swift package update"
      sh "swift package show-dependencies --format json > dependencies.json"
    end
  end
  
  desc "Generate changelog"
  lane :changelog do
    # Get commits since last tag
    last_tag = sh("git describe --tags --abbrev=0").strip
    commits = sh("git log --oneline #{last_tag}..HEAD").strip
    
    # Format changelog
    changelog = "## Changes since #{last_tag}\n\n"
    commits.each_line do |line|
      changelog += "- #{line}"
    end
    
    # Write to file
    File.write("./CHANGELOG.md", changelog)
    
    puts "Changelog generated: ./CHANGELOG.md"
  end
  
  desc "Setup development environment"
  lane :setup do
    # Install gems
    sh "bundle install"
    
    # Install CocoaPods if Podfile exists
    if File.exist?("Podfile")
      sh "bundle exec pod install"
    end
    
    # Install SwiftLint
    sh "brew install swiftlint" unless system("which swiftlint")
    
    # Install fastlane
    sh "sudo gem install fastlane -NV" unless system("which fastlane")
    
    puts "✅ Development environment setup complete!"
  end
  
  # Error handling
  error do |lane, exception|
    slack(
      message: "❌ Fastlane lane #{lane} failed: #{exception.message}",
      success: false,
      payload: {
        "Error" => exception.message,
        "Backtrace" => exception.backtrace.first(5).join("\n")
      }
    )
  end
end